# Copia este archivo como .env y completa la clave del proveedor que uses.

# Proveedor: anthropic | openai | google
LLM_PROVIDER=anthropic

# Nombre exacto del modelo. Revisa cuál tienes disponible en tu cuenta. Ejemplos:
#   anthropic -> claude-sonnet-5-5
#   openai    -> gpt-4.1-mini
#   google    -> gemini-2.5-flash
LLM_MODEL=claude-sonnet-5-5

# Opcional: temperatura (ej. 0). Déjala vacía si el modelo no la acepta.
LLM_TEMPERATURE=

# Opcional: segundos máximos de espera por llamada y máximo de tokens de salida.
# LLM_TIMEOUT=
# LLM_MAX_TOKENS=3000

# Solo hace falta la clave del proveedor elegido.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Cualquier API compatible con OpenAI sirve con LLM_PROVIDER=openai y una URL base:
#   Pruebas sin clave (Pollinations, gratis, con límite de velocidad, NO para la demo):
#     OPENAI_BASE_URL=https://text.pollinations.ai/openai
#     OPENAI_API_KEY=anonimo
#     LLM_MODEL=openai-fast
#     LLM_INTERVALO_MIN=47   (segundos entre llamadas: su límite es 1 respuesta cada 45 s)
#   Modelo local con Ollama (gratis, nada sale del computador):
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     OPENAI_API_KEY=ollama
#     LLM_MODEL=qwen2.5:7b
# OPENAI_BASE_URL=

# Clave para ver, en el panel de calidad, las respuestas que las personas autorizaron guardar.
# Compártela solo con el equipo.
CLAVE_EQUIPO=

# Límites de uso, para que nadie gaste la cuota de la API (valores por defecto entre paréntesis).
# LIMITE_CONSULTAS_SESION=20   (consultas por persona...)
# LIMITE_VENTANA_MIN=10        (...en esta cantidad de minutos)
# LIMITE_CONSULTAS_ANONIMO=5   (consultas sin cuenta en esa ventana; solo si el login está disponible)
# LIMITE_CONSULTAS_MINUTO=30   (consultas por minuto para toda la app)

# Cuenta opcional. Sin estas variables no hay login y la app funciona como siempre.
# AUTH_MOCK=1 simula el login para la demo: no contacta a ningún proveedor y la pantalla lo avisa.
# AUTH_MOCK=
# Secreto para los identificadores seudónimos (solo con proveedor real). Si cambia, las cuentas empiezan de cero.
# Genéralo con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# CUENTAS_SECRETO=
