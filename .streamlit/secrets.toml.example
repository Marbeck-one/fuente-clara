# Credenciales del login con Google. Copia este archivo como .streamlit/secrets.toml (nunca se sube al repo).
# Además hace falta CUENTAS_SECRETO en .env y Authlib instalado. Sin todo eso, la app funciona sin login.

[auth]
# En Google Cloud, «URI de redireccionamiento autorizado» debe ser exactamente este valor.
# Solo sirve localhost o HTTPS: abierta por http://IP:8501 desde otro equipo, Google rechaza la redirección.
redirect_uri = "http://localhost:8501/oauth2callback"
# Genéralo con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = ""
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Solo pedimos la identidad: ni correo ni nombre llegan a la app.
[auth.client_kwargs]
scope = "openid"
